# Copy to .env on the gateway and fill in.

# HTTP server
PORT=8080
HOST=0.0.0.0

# Database file (SQLite)
DB_PATH=./data/hausvpn.db

# WireGuard — set WG_APPLY=1 on the real gateway so peers are actually
# programmed into the interface. Leave unset locally to run the API without
# touching WireGuard.
WG_APPLY=1
WG_INTERFACE=wg0
SUBNET_PREFIX=10.7.0

# Public reachability of THIS gateway, handed to clients in their config.
# Use the server's public IP (or domain) and the WireGuard listen port.
SERVER_ENDPOINT=YOUR_PUBLIC_IP:51820
# Optional: pin the gateway public key explicitly (otherwise read from `wg`).
# SERVER_PUBLIC_KEY=

# DNS handed to clients while connected.
CLIENT_DNS=1.1.1.1, 1.0.0.1

# Free-trial length for new signups (days).
TRIAL_DAYS=7

# Secret for the /v1/admin/activate endpoint (manual entitlement grants
# until billing is wired in). Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me
