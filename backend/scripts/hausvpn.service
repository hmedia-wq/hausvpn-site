[Unit]
Description=HausVPN control plane
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hausvpn/backend
EnvironmentFile=/opt/hausvpn/backend/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
# The service shells out to `wg`/`wg-quick`, which require root.
User=root

[Install]
WantedBy=multi-user.target
